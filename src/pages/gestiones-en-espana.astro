---
import SubpageLayout from '../components/layout/SubpageLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import Icon from '../components/ui/Icon.astro';

const gestiones = [
  {
    icon: 'credit-card',
    title: 'NIE y TIE',
    text: 'Obtención y renovación de tu Número de Identidad de Extranjero y Tarjeta de Identidad de Extranjero.',
  },
  {
    icon: 'map-pin',
    title: 'Empadronamiento',
    text: 'Alta en el padrón municipal, requisito clave para casi cualquier trámite posterior.',
  },
  {
    icon: 'file-text',
    title: 'Certificados y registros',
    text: 'Certificados de nacimiento, matrimonio, antecedentes penales y registros civiles.',
  },
  {
    icon: 'scale',
    title: 'Poderes notariales',
    text: 'Redacción y gestión de poderes para actuar en tu nombre ante cualquier administración.',
  },
  {
    icon: 'check-circle',
    title: 'Renovaciones de residencia',
    text: 'Renovación de tu autorización de residencia antes del vencimiento, sin sorpresas.',
  },
  {
    icon: 'home',
    title: 'Arraigo',
    text: 'Residencia por arraigo social, laboral o familiar si ya te encuentras en España.',
  },
  {
    icon: 'briefcase',
    title: 'Informe de vida laboral',
    text: 'Obtención de tu informe de vida laboral y trámites ante la Seguridad Social.',
  },
  {
    icon: 'users',
    title: 'Tarjeta sanitaria y ayudas',
    text: 'Alta sanitaria y orientación sobre ayudas y servicios públicos disponibles.',
  },
];
---

<SubpageLayout
  title="Gestiones en España — InstitutoDeGestiones | Trámites Administrativos"
  description="¿Ya estás en España? Tramitamos NIE, TIE, empadronamiento, certificados, poderes notariales, renovaciones y arraigo. Evaluación gratuita en 24h."
  canonical="https://institutodegestiones.com/gestiones-en-espana/"
  ctaHref="#evaluacion"
>
  <PageHero
    eyebrow="Gestiones en España"
    title="¿Ya estás en España y necesitas gestiones?"
    subtitle="También tramitamos desde España todo lo que necesitas una vez estés aquí."
  />

  <section class="bg-white py-14 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {gestiones.map((g, i) => (
          <div
            class="fade-in-up flex flex-col gap-3 rounded-card border border-black/10 bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-0.5 hover:shadow-card-hover"
            style={`transition-delay:${i * 75}ms`}
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-card bg-light text-navy">
              <Icon name={g.icon} class="h-6 w-6" />
            </span>
            <h2 class="font-display text-lg font-semibold text-tinta">{g.title}</h2>
            <p class="text-sm leading-relaxed text-muted">{g.text}</p>
          </div>
        ))}
      </div>

      <div class="mx-auto mt-14 max-w-3xl text-center">
        <h2 class="font-display text-2xl font-bold text-navy">¿No encuentras tu gestión?</h2>
        <p class="mt-3 text-body-lg text-muted">
          Tramitamos prácticamente cualquier gestión administrativa en España. Cuéntanos qué necesitas y te decimos si
          podemos ayudarte — sin coste.
        </p>
      </div>
    </div>
  </section>

  <FinalCTA />
</SubpageLayout>
