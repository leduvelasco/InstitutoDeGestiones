---
import SubpageLayout from '../../components/layout/SubpageLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import Icon from '../../components/ui/Icon.astro';

const familiares = [
  'Cónyuge o pareja de hecho registrada',
  'Hijos menores de 18 años',
  'Hijos mayores de 18 años con discapacidad',
  'Ascendientes a cargo (padres) en supuestos previstos por la norma',
];

const requisitos = [
  'Un año de residencia legal en España y haber solicitado la renovación',
  'Medios económicos suficientes para mantener a tu familia',
  'Vivienda adecuada: informe de alojamiento del ayuntamiento',
  'Seguro médico o alta en la Seguridad Social de cada familiar',
  'Documentación familiar apostillada (matrimonio, nacimiento)',
];

const pasos = [
  'Solicitud inicial de autorización de residencia por reagrupación en España',
  'Resolución favorable y cita en el consulado del país de origen',
  'Visado de reagrupación familiar del familiar',
  'Entrada en España y obtención de la TIE del familiar reagrupado',
];
---

<SubpageLayout
  title="Reagrupación Familiar en España — InstitutoDeGestiones"
  description="Trae a tu pareja e hijos a España de forma legal. Gestionamos tu reagrupación familiar completa: requisitos, plazos y trámites. Evaluación gratuita en 24h."
  canonical="https://institutodegestiones.com/residencia/reagrupacion-familiar/"
  ctaHref="#evaluacion"
>
  <PageHero
    eyebrow="Visados y Residencia"
    title="Reagrupación Familiar"
    subtitle="Reúne a tu pareja e hijos contigo en España de forma completamente legal."
  />

  <section class="bg-white py-14 lg:py-20">
    <div class="mx-auto max-w-4xl space-y-12 px-4 lg:px-8">
      <div class="fade-in-up space-y-4 text-body-lg text-muted">
        <p>
          Si ya tienes residencia legal en España, puedes traer a tu familia mediante la reagrupación familiar. Es un
          trámite que se solicita <strong class="text-ink">desde España</strong>, y una vez aprobado, tu familia
          obtiene visado y residencia.
        </p>
      </div>

      <div class="fade-in-up">
        <h2 class="font-display text-2xl font-bold text-navy">¿A quién puedes reagrupar?</h2>
        <ul class="mt-5 space-y-3">
          {familiares.map((f) => (
            <li class="flex items-start gap-3">
              <Icon name="users" class="mt-1 h-5 w-5 shrink-0 text-blue" />
              <span class="text-ink">{f}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="fade-in-up">
        <h2 class="font-display text-2xl font-bold text-navy">Requisitos principales</h2>
        <ul class="mt-5 space-y-3">
          {requisitos.map((r) => (
            <li class="flex items-start gap-3">
              <Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-gold" />
              <span class="text-ink">{r}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="fade-in-up">
        <h2 class="font-display text-2xl font-bold text-navy">El proceso paso a paso</h2>
        <ol class="mt-6 space-y-4">
          {pasos.map((p, i) => (
            <li class="flex items-start gap-4">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gold font-bold text-white">{i + 1}</span>
              <span class="pt-1.5 text-ink">{p}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="fade-in-up rounded-card bg-light p-8">
        <h2 class="font-display text-2xl font-bold text-navy">Plazos reales</h2>
        <p class="mt-3 text-body-lg text-muted">
          La resolución de la solicitud suele tardar entre 2 y 4 meses, y el visado consular otras 4–8 semanas. En
          total, cuenta con <strong class="text-ink">4–6 meses</strong> desde que presentamos la solicitud hasta que
          tu familia está contigo.
        </p>
      </div>
    </div>
  </section>

  <FinalCTA />
</SubpageLayout>
