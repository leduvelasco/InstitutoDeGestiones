---
import SubpageLayout from '../../components/layout/SubpageLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import Icon from '../../components/ui/Icon.astro';

const requisitos = [
  'Carta de admisión de un centro de enseñanza reconocido en España',
  'Medios económicos suficientes (mínimo 100% del IPREM mensual)',
  'Seguro médico privado sin carencias ni copagos',
  'Certificado de antecedentes penales apostillado',
  'Certificado médico oficial',
  'Pasaporte en vigor con al menos un año de validez',
];

const incluye = [
  'Análisis de tu caso y del centro de estudios',
  'Revisión y preparación de toda la documentación',
  'Legalizaciones y apostillas necesarias',
  'Presentación de la solicitud ante el consulado',
  'Preparación para la cita consular',
  'Seguimiento hasta la resolución y orientación de llegada',
];
---

<SubpageLayout
  title="Visado de Estudios en España — InstitutoDeGestiones"
  description="Estudia en España con residencia y autorización para trabajar hasta 30h semanales. Gestionamos tu visado de estudios completo. Evaluación gratuita en 24h."
  canonical="https://institutodegestiones.com/visado/visado-de-estudios/"
  ctaHref="#evaluacion"
>
  <PageHero
    eyebrow="Visados y Residencia"
    title="Visado de Estudios en España"
    subtitle="Estudia en España con residencia y autorización para trabajar hasta 30 horas semanales."
  />

  <section class="bg-white py-14 lg:py-20">
    <div class="mx-auto max-w-4xl space-y-12 px-4 lg:px-8">
      <div class="fade-in-up space-y-4 text-body-lg text-muted">
        <p>
          El visado de estudios es una de las vías más rápidas para vivir legalmente en España. Te permite cursar
          estudios superiores, idiomas o formación profesional, trabajar hasta 30 horas semanales con autorización, y
          es compatible con traer a tu familia en determinados supuestos.
        </p>
        <p>
          La resolución suele llegar en <strong class="text-ink">30–90 días</strong>. El principal riesgo no es la vía
          en sí, sino los errores de forma: seguros no válidos, medios económicos mal justificados o documentos sin
          apostillar. Nosotros nos encargamos de que nada de eso ocurra.
        </p>
      </div>

      <div class="fade-in-up">
        <h2 class="font-display text-2xl font-bold text-navy">Requisitos principales</h2>
        <ul class="mt-5 space-y-3">
          {requisitos.map((r) => (
            <li class="flex items-start gap-3">
              <Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-gold" />
              <span class="text-ink">{r}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="fade-in-up">
        <h2 class="font-display text-2xl font-bold text-navy">¿Qué incluye nuestro servicio?</h2>
        <ul class="mt-5 space-y-3">
          {incluye.map((r) => (
            <li class="flex items-start gap-3">
              <Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-gold" />
              <span class="text-ink">{r}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="fade-in-up rounded-card bg-light p-8">
        <h2 class="font-display text-2xl font-bold text-navy">¿Cuándo empezar?</h2>
        <p class="mt-3 text-body-lg text-muted">
          Lo recomendable es iniciar el trámite con <strong class="text-ink">3–4 meses de antelación</strong> al inicio
          del curso: la cita consular puede tardar 6–8 semanas y la resolución otros 30–60 días.
        </p>
      </div>
    </div>
  </section>

  <FinalCTA />
</SubpageLayout>
