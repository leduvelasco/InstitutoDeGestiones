---
import SubpageLayout from '../components/layout/SubpageLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import StatCounter from '../components/ui/StatCounter.astro';
import Icon from '../components/ui/Icon.astro';

const stats = [
  { value: '25+', label: 'Años de experiencia' },
  { value: '4.578', label: 'Clientes atendidos' },
  { value: '15', label: 'Países de origen' },
  { value: '2.500', label: 'Títulos homologados' },
];

const values = [
  {
    icon: 'search',
    title: 'Análisis antes que venta',
    text: 'Estudiamos tu situación familiar, académica y laboral antes de recomendarte cualquier trámite.',
  },
  {
    icon: 'message-circle',
    title: 'Comunicación clara',
    text: 'Te explicamos requisitos, plazos y costes reales desde el primer día. Sin promesas vacías.',
  },
  {
    icon: 'briefcase',
    title: 'Acompañamiento completo',
    text: 'Te acompañamos desde la primera consulta hasta tu llegada e instalación en España.',
  },
];
---

<SubpageLayout
  title="Sobre Nosotros — InstitutoDeGestiones | Especialistas en Migraciones a España"
  description="Más de 25 años ayudando a latinoamericanos a vivir legalmente en España. Conoce al equipo de InstitutoDeGestiones y nuestra forma de trabajar."
  canonical="https://institutodegestiones.com/sobre-nosotros/"
  ctaHref="#evaluacion"
>
  <PageHero
    eyebrow="Quiénes somos"
    title="Más de 25 años acompañando historias entre Latinoamérica y España"
    subtitle="No gestionamos papeles: acompañamos proyectos de vida."
  />

  <section class="bg-white py-14 lg:py-20">
    <div class="mx-auto grid max-w-7xl items-start gap-10 px-4 lg:grid-cols-2 lg:gap-16 lg:px-8">
      <div class="fade-in-up">
        <h2 class="font-display text-3xl font-bold text-tinta lg:text-display-lg">Nuestra historia</h2>
        <div class="mt-5 space-y-4 text-body-lg text-muted">
          <p>
            Instituto de Gestiones nació hace más de 25 años con una misión clara: que ningún latinoamericano se
            enfrente solo a la burocracia migratoria española.
          </p>
          <p>
            En este tiempo hemos gestionado más de 4.500 casos de visados, residencias, reagrupaciones familiares y
            homologaciones de títulos. Cada expediente nos ha enseñado algo nuevo sobre cómo funciona realmente la
            administración española — y sobre lo que las personas necesitan de verdad cuando emigran.
          </p>
          <p>
            Hoy seguimos trabajando igual que el primer día: escuchando tu caso, diciéndote la verdad sobre tus
            opciones y acompañándote hasta el final del proceso.
          </p>
        </div>
      </div>
      <div class="fade-in-up" style="transition-delay: 150ms">
        <figure class="rounded-card border border-black/10 bg-light p-8 shadow-card sm:p-10">
          <blockquote class="font-display text-2xl font-semibold italic leading-snug text-tinta lg:text-[1.75rem]">
            “Ningún expediente es un papel: es el proyecto de vida de alguien.”
          </blockquote>
          <figcaption class="mt-6 border-t border-ink/10 pt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-muted">
            Instituto de Gestiones · Madrid, desde 1999
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="bg-light py-14 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 lg:px-8">
      <div class="fade-in-up max-w-2xl">
        <p class="font-mono text-[11px] font-medium uppercase tracking-[0.24em] text-gold">Cómo trabajamos</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-tinta lg:text-display-lg">Tres normas de la casa</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {values.map((v, i) => (
          <div class="fade-in-up rounded-card border border-black/10 bg-white p-7 shadow-card" style={`transition-delay:${i * 80}ms`}>
            <span class="flex h-12 w-12 items-center justify-center rounded-card bg-light text-navy">
              <Icon name={v.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-5 font-display text-xl font-semibold text-tinta">{v.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{v.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-14 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-ink/10 pt-10 md:grid-cols-4">
        {stats.map((s) => <StatCounter value={s.value} label={s.label} />)}
      </div>
    </div>
  </section>

  <FinalCTA />
</SubpageLayout>
