---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="flex flex-col border-l border-ink/10 pl-4">
  <span class="font-display text-3xl font-bold text-tinta">{value}</span>
  <span class="mt-1.5 font-mono text-[10px] uppercase tracking-[0.16em] text-muted">{label}</span>
</div>
