---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  tag: string;
  title: string;
  description: string;
  href: string;
}

const { icon, tag, title, description, href } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-card border border-black/10 bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-0.5 hover:border-navy/40 hover:shadow-card-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sello"
>
  <div class="flex items-start justify-between gap-3">
    <span class="flex h-12 w-12 items-center justify-center rounded-card bg-light text-navy">
      <Icon name={icon} class="h-6 w-6" />
    </span>
    <span class="rounded-card border border-ink/15 px-2 py-1 font-mono text-[9px] uppercase tracking-[0.14em] text-muted">{tag}</span>
  </div>
  <h3 class="mt-5 font-display text-xl font-semibold text-tinta">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-muted">{description}</p>
  <span class="mt-auto inline-flex items-center gap-1 pt-5 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-navy">
    Ver detalles <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
  </span>
</a>
