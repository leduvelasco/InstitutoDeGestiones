---
import { COUNTRIES, FORM_SERVICES } from '../../data/site';

interface Props {
  service?: string;
}

const { service } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);

const labelClass = 'mb-1.5 block font-mono text-[10px] font-medium uppercase tracking-[0.18em] text-muted';
const inputClass =
  'w-full rounded-card border border-ink/20 bg-white px-3.5 py-3 font-body text-[15px] text-ink placeholder:text-ink/35 focus:border-navy focus:outline focus:outline-2 focus:outline-navy';
---

<div class="relative rounded-card border border-black/10 bg-white shadow-card">
  <p class="flex items-center justify-between gap-3 border-b border-black/10 bg-tinta px-5 py-3 font-mono text-[10px] uppercase tracking-[0.18em] text-white/85 sm:px-6">
    <span>Modelo IG-01 · Solicitud de evaluación</span>
    <span class="hidden text-white/50 sm:inline">Extranjería</span>
  </p>

  <span class="stamp absolute -top-4 right-5 z-10 -rotate-6 bg-white text-[9px] text-navy sm:text-[10px]" aria-hidden="true">
    Sin coste · Respuesta en 24&nbsp;h
  </span>

  <form data-lead-form class="relative p-5 sm:p-6" novalidate>
    <div class="space-y-4">
      <div>
        <label for={`lead-${uid}-name`} class={labelClass}>01 — Nombre completo</label>
        <input
          id={`lead-${uid}-name`}
          name="name"
          type="text"
          placeholder="Nombre y apellidos"
          autocomplete="name"
          maxlength="120"
          required
          class={inputClass}
        />
        <p class="mt-1 hidden text-sm text-sello" data-field-error role="alert"></p>
      </div>
      <div>
        <label for={`lead-${uid}-whatsapp`} class={labelClass}>02 — WhatsApp (con código de país)</label>
        <input
          id={`lead-${uid}-whatsapp`}
          name="whatsapp"
          type="tel"
          placeholder="+57 300 000 000"
          autocomplete="tel"
          required
          class={inputClass}
        />
        <p class="mt-1 hidden text-sm text-sello" data-field-error role="alert"></p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for={`lead-${uid}-country`} class={labelClass}>03 — País de origen</label>
          <select id={`lead-${uid}-country`} name="country" required class={inputClass}>
            <option value="" selected disabled>Selecciona país</option>
            {COUNTRIES.map((c) => <option value={c}>{c}</option>)}
          </select>
          <p class="mt-1 hidden text-sm text-sello" data-field-error role="alert"></p>
        </div>
        <div>
          <label for={`lead-${uid}-service`} class={labelClass}>04 — Trámite que necesitas</label>
          <select id={`lead-${uid}-service`} name="service" required class={inputClass}>
            {service
              ? <option value={service} selected>{service}</option>
              : <option value="" selected disabled>Selecciona trámite</option>
            }
            {FORM_SERVICES.filter((s) => s !== service).map((s) => <option value={s}>{s}</option>)}
          </select>
          <p class="mt-1 hidden text-sm text-sello" data-field-error role="alert"></p>
        </div>
      </div>
    </div>

    <div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
      <label for={`lead-${uid}-website`}>No rellenes este campo</label>
      <input id={`lead-${uid}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <button
      type="submit"
      class="mt-5 w-full rounded-card bg-sello py-3.5 font-body text-sm font-semibold uppercase tracking-[0.08em] text-white transition-colors hover:bg-[#8F322B] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sello disabled:cursor-not-allowed disabled:opacity-70"
    >
      <span class="inline-flex items-center justify-center gap-2">
        <span data-btn-label data-label="Solicitar evaluación gratuita">Solicitar evaluación gratuita</span>
        <svg data-btn-spinner class="hidden h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z"></path>
        </svg>
      </span>
    </button>

    <p class="mt-3 text-center font-mono text-[10px] uppercase tracking-[0.14em] text-muted">
      Sin compromiso · Confidencial
    </p>
    <p class="mt-2 text-center text-xs leading-relaxed text-muted">
      Tus datos se usan solo para evaluar tu caso, conforme al RGPD.
      <a href="/politica-de-privacidad-policy/" target="_blank" rel="noopener" class="underline decoration-ink/30 underline-offset-2 hover:decoration-ink">Política de privacidad</a>.
    </p>
    <p class="hidden text-center text-sm" data-form-status role="status" aria-live="polite"></p>
  </form>
</div>

<script>
  import { COUNTRIES, FORM_SERVICES, WHATSAPP_URL } from '../../data/site';
  import { LeadApiError, getTrackingParams, submitLead, type LeadPayload } from '../../services/leadApi';

  getTrackingParams();

  const messages: Record<string, string> = {
    name: 'Introduce tu nombre completo (mínimo 3 caracteres).',
    whatsapp: 'Introduce un número de WhatsApp válido, con código de país.',
    country: 'Selecciona el país desde donde nos escribes.',
    service: 'Selecciona el trámite que necesitas.',
  };

  const genericErrorHtml = `No pudimos enviar tu solicitud, inténtalo de nuevo.
    <button type="button" data-retry class="font-semibold underline">Reintentar</button>
    o escríbenos por <a href="${WHATSAPP_URL}" target="_blank" rel="noopener" class="font-semibold underline">WhatsApp</a>.`;

  function isValid(field: HTMLInputElement | HTMLSelectElement): boolean {
    const value = field.value.trim();
    if (field.name === 'name') return value.length >= 3 && value.length <= 120;
    if (field.name === 'whatsapp') return /^\+?[\d\s-]{7,15}$/.test(value);
    if (field.name === 'country') return COUNTRIES.includes(value);
    if (field.name === 'service') return FORM_SERVICES.includes(value);
    return true;
  }

  function setFieldError(field: HTMLInputElement | HTMLSelectElement, message: string): void {
    const errorEl = field.closest('div')?.querySelector<HTMLElement>('[data-field-error]');
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.toggle('hidden', !message);
    }
    field.classList.toggle('border-sello', !!message);
    field.classList.toggle('border-ink/20', !message);
  }

  function validateField(field: HTMLInputElement | HTMLSelectElement): boolean {
    const valid = isValid(field);
    setFieldError(field, valid ? '' : (messages[field.name] ?? 'Campo obligatorio.'));
    return valid;
  }

  function showStatus(status: HTMLElement, html: string): void {
    status.innerHTML = html;
    status.classList.remove('hidden', 'text-navy');
    status.classList.add('text-sello');
  }

  function hideStatus(status: HTMLElement): void {
    status.textContent = '';
    status.classList.add('hidden');
  }

  function setLoading(form: HTMLFormElement, loading: boolean): void {
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!btn) return;
    btn.disabled = loading;
    btn.setAttribute('aria-busy', String(loading));
    btn.querySelector<HTMLElement>('[data-btn-spinner]')?.classList.toggle('hidden', !loading);
    const label = btn.querySelector<HTMLElement>('[data-btn-label]');
    if (label) label.textContent = loading ? 'Enviando…' : (label.dataset.label ?? label.textContent);
  }

  function handleSendError(
    form: HTMLFormElement,
    btn: HTMLButtonElement,
    status: HTMLElement,
    err: unknown
  ): void {
    if (err instanceof LeadApiError && err.code === 'VALIDATION_ERROR' && err.fields) {
      let firstInvalid: HTMLElement | null = null;
      for (const [name, message] of Object.entries(err.fields)) {
        const field = form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`);
        if (!field) continue;
        setFieldError(field, message);
        firstInvalid ??= field;
      }
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }
    } else if (err instanceof LeadApiError && err.code === 'RATE_LIMITED') {
      showStatus(status, 'Has hecho demasiados intentos. Inténtalo de nuevo en unos minutos.');
      btn.disabled = true;
      window.setTimeout(() => {
        btn.disabled = false;
      }, 60_000);
      return;
    }
    showStatus(status, genericErrorHtml);
    status.querySelector<HTMLButtonElement>('[data-retry]')?.addEventListener('click', () => {
      void send(form);
    });
  }

  async function send(form: HTMLFormElement): Promise<void> {
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    if (!btn || !status || form.dataset.sending === 'true') return;

    let valid = true;
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input:not([name="website"]), select').forEach((f) => {
      if (!validateField(f)) valid = false;
    });
    if (!valid) return;

    form.dataset.sending = 'true';
    setLoading(form, true);
    hideStatus(status);

    const fd = new FormData(form);
    const str = (value: FormDataEntryValue | null) => (typeof value === 'string' ? value.trim() : '');
    const payload: LeadPayload = {
      name: str(fd.get('name')),
      whatsapp: str(fd.get('whatsapp')),
      country: str(fd.get('country')),
      service: str(fd.get('service')),
      website: str(fd.get('website')),
      page_url: window.location.href.slice(0, 512),
      ...getTrackingParams(),
    };

    try {
      await submitLead(payload);
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'generate_lead', service: payload.service });
      form.reset();
      form.innerHTML =
        '<p class="py-8 text-center font-mono text-xs uppercase tracking-[0.14em] text-navy">Solicitud recibida — Te contactamos en menos de 24 h laborables.</p>';
    } catch (err) {
      handleSendError(form, btn, status, err);
    } finally {
      form.dataset.sending = 'false';
      setLoading(form, false);
    }
  }

  document.querySelectorAll<HTMLFormElement>('form[data-lead-form]').forEach((form) => {
    const fields = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input:not([name="website"]), select')
    );

    fields.forEach((field) => {
      field.addEventListener('blur', () => validateField(field));
      field.addEventListener('input', () => {
        const errorEl = field.closest('div')?.querySelector<HTMLElement>('[data-field-error]');
        if (errorEl && !errorEl.classList.contains('hidden')) validateField(field);
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      void send(form);
    });
  });
</script>
