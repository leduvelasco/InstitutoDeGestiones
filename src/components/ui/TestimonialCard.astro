---
interface Props {
  quote: string;
  author: string;
  country: string;
  result: string;
  caseId: string;
}

const { quote, author, country, result, caseId } = Astro.props;
---

<figure class="flex h-full flex-col rounded-card border border-black/10 bg-white p-6 shadow-card sm:p-7">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/10 pb-4">
    <figcaption class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted">{caseId} · {result}</figcaption>
    <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-gold">Resuelto favorable</span>
  </div>
  <blockquote class="mt-5 font-display text-lg font-medium italic leading-relaxed text-ink">
    “{quote}”
  </blockquote>
  <p class="mt-auto pt-5 text-sm">
    <span class="font-semibold text-tinta">{author}</span>
    <span class="ml-2 font-mono text-[11px] uppercase tracking-[0.14em] text-muted">{country}</span>
  </p>
</figure>
