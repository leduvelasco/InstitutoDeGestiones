---
import Icon from './Icon.astro';
import { WHATSAPP_URL } from '../../data/site';

interface Props {
  ctaHref?: string;
}

const { ctaHref = '/contacto/#evaluacion' } = Astro.props;
---

<div class="h-16 md:hidden" aria-hidden="true"></div>
<nav class="fixed inset-x-0 bottom-0 z-[999] grid grid-cols-2 border-t border-black/10 md:hidden" aria-label="Contacto rápido">
  <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="flex items-center justify-center gap-2 bg-[#25D366] py-4 text-sm font-semibold text-white">
    <Icon name="whatsapp" class="h-5 w-5" />
    WhatsApp
  </a>
  <a href={ctaHref} class="flex items-center justify-center gap-2 bg-sello py-4 text-sm font-semibold text-white">
    Evaluación gratuita
  </a>
</nav>
