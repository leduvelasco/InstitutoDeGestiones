---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import StickyMobileBar from '../ui/StickyMobileBar.astro';
import WhatsAppFloat from '../ui/WhatsAppFloat.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ctaHref?: string;
}

const { title, description, canonical, ctaHref = '/contacto/#evaluacion' } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <StickyMobileBar ctaHref={ctaHref} />
  <WhatsAppFloat />
</BaseLayout>
