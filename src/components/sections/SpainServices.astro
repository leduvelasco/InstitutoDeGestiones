---
import Icon from '../ui/Icon.astro';

const items = [
  { icon: 'credit-card', label: 'NIE y TIE', tag: 'Modelos EX-15 / EX-17' },
  { icon: 'file-text', label: 'Certificados y registros', tag: 'Registro Civil' },
  { icon: 'scale', label: 'Poderes notariales', tag: 'Notaría' },
  { icon: 'map-pin', label: 'Empadronamiento', tag: 'Padrón municipal' },
];
---

<section class="bg-light py-14 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <div class="fade-in-up max-w-2xl">
      <p class="font-mono text-[11px] font-medium uppercase tracking-[0.24em] text-gold">Gestiones en España</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-tinta lg:text-display-lg">
        ¿Ya estás en España y necesitas gestiones?
      </h2>
      <p class="mt-3 text-body-lg text-muted">
        También tramitamos desde España todo lo que necesitas una vez estés aquí.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((item, i) => (
        <div
          class="fade-in-up flex flex-col gap-3 rounded-card border border-black/10 bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-0.5 hover:shadow-card-hover"
          style={`transition-delay:${i * 80}ms`}
        >
          <span class="flex h-12 w-12 items-center justify-center rounded-card bg-light text-navy">
            <Icon name={item.icon} class="h-6 w-6" />
          </span>
          <p class="font-display text-lg font-semibold text-tinta">{item.label}</p>
          <p class="mt-auto font-mono text-[10px] uppercase tracking-[0.14em] text-muted">{item.tag}</p>
        </div>
      ))}
    </div>

    <p class="mt-10">
      <a href="/gestiones-en-espana/" class="inline-flex items-center gap-1 font-mono text-xs font-medium uppercase tracking-[0.14em] text-navy underline-offset-4 hover:underline">
        Ver todas las gestiones disponibles <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>
