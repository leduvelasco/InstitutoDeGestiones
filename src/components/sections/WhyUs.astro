---
import Icon from '../ui/Icon.astro';

const advantages = [
  '+25 años de experiencia en extranjería',
  'Equipo especializado en España y Latinoamérica',
  'Atención personalizada, no masiva',
  'Seguimiento del expediente hasta la resolución final',
  'Sin letra pequeña: te decimos lo que aplica a tu caso',
];

const normas = [
  { ref: 'Ley Orgánica 4/2000', text: 'Derechos y libertades de los extranjeros en España' },
  { ref: 'Real Decreto 557/2011', text: 'Reglamento de la Ley de Extranjería' },
  { ref: 'Real Decreto 889/2022', text: 'Homologación y equivalencia de títulos' },
  { ref: 'Código Civil', text: 'Nacionalidad española por residencia' },
];
---

<section class="bg-white py-14 lg:py-20">
  <div class="mx-auto grid max-w-7xl items-start gap-10 px-4 lg:grid-cols-2 lg:gap-16 lg:px-8">
    <div class="fade-in-up">
      <p class="font-mono text-[11px] font-medium uppercase tracking-[0.24em] text-gold">Nuestra diferencia</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-tinta lg:text-display-lg">
        No somos una gestoría más. Somos especialistas en España.
      </h2>
      <p class="mt-5 text-body-lg text-muted">
        Detrás de cada trámite hay una historia personal. Por eso analizamos tu situación concreta —familiar,
        académica, laboral— antes de recomendarte nada. Nuestro objetivo es encontrar la vía legal más adecuada para
        ti, sin perder tiempo en gestiones que no aplican a tu caso.
      </p>
      <ul class="mt-8 space-y-3">
        {advantages.map((a) => (
          <li class="flex items-start gap-3">
            <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-gold" />
            <span class="text-ink">{a}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="fade-in-up" style="transition-delay: 150ms">
      <div class="rounded-card border border-black/10 bg-light shadow-card">
        <p class="border-b border-ink/10 px-6 py-4 font-mono text-[10px] font-medium uppercase tracking-[0.18em] text-muted">
          Marco normativo con el que trabajamos
        </p>
        <ul class="divide-y divide-ink/10">
          {normas.map((n) => (
            <li class="flex items-baseline justify-between gap-4 px-6 py-4">
              <span class="font-display text-base font-semibold text-tinta">{n.ref}</span>
              <span class="text-right text-sm text-muted">{n.text}</span>
            </li>
          ))}
        </ul>
        <p class="border-t border-ink/10 px-6 py-4 text-sm leading-relaxed text-muted">
          Trabajamos contra la norma vigente, no contra rumores de foro. Cada recomendación que recibes cita la vía
          legal exacta que la sustenta.
        </p>
      </div>
    </div>
  </div>
</section>
