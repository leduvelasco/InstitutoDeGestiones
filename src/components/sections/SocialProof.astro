---
import StatCounter from '../ui/StatCounter.astro';

const stats = [
  { value: '4.578', label: 'Clientes atendidos' },
  { value: '1.564', label: 'Visados gestionados' },
  { value: '2.500', label: 'Títulos homologados' },
  { value: '1.254', label: 'Expedientes migratorios' },
  { value: '15', label: 'Países de origen' },
];
---

<section class="border-b border-ink/10 bg-white py-10 lg:py-12">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <div class="fade-in-up grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3 lg:grid-cols-5">
      {stats.map((s) => <StatCounter value={s.value} label={s.label} />)}
    </div>
  </div>
</section>
